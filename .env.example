# Copy this file to .env.local for local testing, or set these directly in
# the Cloudflare Pages dashboard under Settings -> Environment variables.
# Never commit a real .env file with live values — .env and .env.local are
# already gitignored.
#
# All variables below are optional. Leaving them unset simply means that
# provider's tracking script never loads (see src/lib/analytics.ts and
# src/components/analytics/AnalyticsHead.astro).

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads conversion ID, e.g. AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Meta (Facebook/Instagram) Pixel ID
PUBLIC_META_PIXEL_ID=

# Google Search Console HTML meta tag verification value.
# Only needed if you're not verifying via a DNS TXT record instead.
PUBLIC_GSC_VERIFICATION=

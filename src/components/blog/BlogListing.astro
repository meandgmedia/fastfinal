---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../marketing/PageHero.astro";
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";
import BlogPagination from "./BlogPagination.astro";
import { CTA as CTA_COPY } from "../../data/site";
import { BLOG_CATEGORIES } from "../../content.config";
import { webPageSchema, breadcrumbSchema } from "../../lib/schema";
import { getCollection } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { posts, currentPage, lastPage, prevUrl, nextUrl } = Astro.props;

const title = currentPage === 1 ? "Blog" : `Blog — Page ${currentPage}`;
const description =
  "Guides and articles on Florida final expense insurance, burial insurance, and life insurance for seniors — written to help you make an informed decision.";
const path = currentPage === 1 ? "/blog/" : `/blog/${currentPage}/`;

// Category pills reflect categories present across the whole blog, not just
// this page, but filtering only ever operates on the posts actually
// rendered on the current page — see the note in the script below.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const usedCategorySlugs = new Set(allPosts.map((p) => p.data.category));
const activeCategories = BLOG_CATEGORIES.filter((c) => usedCategorySlugs.has(c.slug));

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

// Full dataset for client-side search/filtering across the ENTIRE blog, not
// just the posts rendered on this page. Kept intentionally minimal (no
// heroImage credit, no body content) to keep this payload small.
const allPostsSorted = [...allPosts].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const searchIndex = allPostsSorted.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  image: post.data.heroImage.url,
  date: dateFormatter.format(post.data.publishDate),
  iso: post.data.publishDate.toISOString(),
}));

const schema = [
  webPageSchema({ title, description, path }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema} noindex={currentPage > 1}>
  <PageHero
    eyebrow="Blog"
    heading="Florida final expense insurance guides & articles"
    lede="Straightforward, no-fluff explainers to help you understand final expense insurance before you buy — not just before you buy from us."
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]}
    primaryLabel={CTA_COPY.secondary}
    primaryHref={CTA_COPY.quoteHref}
  />

  <Section tone="surface">
    <div class="blog-controls">
      <label class="blog-search" for="blog-search-input">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="blog-search__icon"><circle cx="9" cy="9" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="14" y1="14" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input
          type="search"
          id="blog-search-input"
          data-blog-search
          placeholder="Search all articles..."
          aria-label="Search all articles"
        />
      </label>

      {
        activeCategories.length > 0 && (
          <div class="blog-categories" role="group" aria-label="Filter by category">
            <button type="button" class="blog-category-pill is-active" data-category-filter="all">
              All
            </button>
            {activeCategories.map((cat) => (
              <button type="button" class="blog-category-pill" data-category-filter={cat.slug}>
                {cat.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <p class="blog-empty-state" data-empty-state hidden>No articles match your search — try a different term or clear your search.</p>

    <ul class="post-list" data-search-results hidden></ul>

    {
      posts.length > 0 ? (
        <ul class="post-list" data-post-list>
          {posts.map((post) => (
            <Card
              as="li"
              href={`/blog/${post.id}/`}
              padding="lg"
              class="post-list__card"
              data-post-card
              data-category={post.data.category}
              data-search-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
            >
              <div class="post-list__art">
                <img src={post.data.heroImage.url} alt="" width="800" height="450" loading="lazy" />
              </div>
              <time datetime={post.data.publishDate.toISOString()} class="post-list__date text-mono text-subtle">
                {dateFormatter.format(post.data.publishDate)}
              </time>
              <h2 class="post-list__title">{post.data.title}</h2>
              <p class="text-muted">{post.data.description}</p>
              <span class="post-list__link">Read article →</span>
            </Card>
          ))}
        </ul>
      ) : (
        <p class="text-muted">New articles are on the way — check back soon.</p>
      )
    }

    <div data-pagination-wrapper>
      <BlogPagination
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        currentPage={currentPage}
        lastPage={lastPage}
      />
    </div>
  </Section>

  <script type="application/json" id="blog-search-index" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<style>
  .blog-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .blog-search {
    position: relative;
    display: block;
    max-width: 26rem;
  }

  .blog-search__icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-text-subtle);
    pointer-events: none;
  }

  .blog-search input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-base);
  }

  .blog-search input:focus-visible {
    border-color: var(--color-ink-800);
  }

  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-category-pill {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .blog-category-pill:hover {
    border-color: var(--color-ink-600);
  }

  .blog-category-pill.is-active {
    background: var(--color-ink-900);
    border-color: var(--color-ink-900);
    color: var(--color-text-on-dark);
  }

  .blog-empty-state {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: var(--container-max);
  }

  /*
   * Search results are injected client-side via innerHTML, so they never
   * receive Astro's per-build scoped-style attribute. Everything a
   * .post-list__card needs to look correct — including what would
   * otherwise come from Card.astro's own scoped .card/.card--pad-lg/
   * .card--link rules — is duplicated here as :global() so it applies
   * consistently whether the markup came from the server or from JS.
   */
  :global(.post-list__card) {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    padding: var(--space-7);
    transition: border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  :global(.post-list__card:hover) {
    border-color: var(--color-ink-600);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  :global(.post-list__art) {
    margin: calc(var(--space-7) * -1) calc(var(--space-7) * -1) var(--space-5);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }

  :global(.post-list__art img) {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  :global(.post-list__date) {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
  }

  :global(.post-list__title) {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  :global(.post-list__card p) {
    color: var(--color-text-muted);
  }

  :global(.post-list__link) {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-accent-700);
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .post-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Search and category filtering work across the ENTIRE blog (all posts,
  // every page), not just whatever happens to be rendered on this page.
  // When a search/filter is active, results are rendered client-side from
  // the full JSON index below and replace the server-rendered paginated
  // list; clearing the search/filter restores the normal paginated view.
  interface IndexedPost {
    id: string;
    title: string;
    description: string;
    category: string;
    image: string;
    date: string;
    iso: string;
  }

  const searchInput = document.querySelector<HTMLInputElement>("[data-blog-search]");
  const categoryPills = document.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const serverList = document.querySelector<HTMLElement>("[data-post-list]");
  const resultsList = document.querySelector<HTMLElement>("[data-search-results]");
  const paginationWrapper = document.querySelector<HTMLElement>("[data-pagination-wrapper]");
  const indexScript = document.getElementById("blog-search-index");

  const allPosts: IndexedPost[] = indexScript?.textContent ? JSON.parse(indexScript.textContent) : [];

  let activeCategory = "all";

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function renderResults(matches: IndexedPost[]) {
    if (!resultsList) return;
    resultsList.innerHTML = matches
      .map(
        (post) => `
        <li>
          <a href="/blog/${post.id}/" class="card card--pad-lg card--link post-list__card">
            <div class="post-list__art">
              <img src="${escapeHtml(post.image)}" alt="" width="800" height="450" loading="lazy" />
            </div>
            <time datetime="${post.iso}" class="post-list__date text-mono text-subtle">${escapeHtml(post.date)}</time>
            <h2 class="post-list__title">${escapeHtml(post.title)}</h2>
            <p class="text-muted">${escapeHtml(post.description)}</p>
            <span class="post-list__link">Read article →</span>
          </a>
        </li>`
      )
      .join("");
  }

  function applyFilters() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    const isFiltering = query !== "" || activeCategory !== "all";

    if (!isFiltering) {
      // No active search/filter — restore the normal paginated view.
      if (resultsList) resultsList.hidden = true;
      if (serverList) serverList.hidden = false;
      if (paginationWrapper) paginationWrapper.hidden = false;
      if (emptyState) emptyState.hidden = true;
      return;
    }

    const matches = allPosts.filter((post) => {
      const matchesCategory = activeCategory === "all" || post.category === activeCategory;
      const matchesSearch = !query || `${post.title} ${post.description}`.toLowerCase().includes(query);
      return matchesCategory && matchesSearch;
    });

    renderResults(matches);

    if (serverList) serverList.hidden = true;
    if (paginationWrapper) paginationWrapper.hidden = true;
    if (resultsList) resultsList.hidden = matches.length === 0;
    if (emptyState) emptyState.hidden = matches.length > 0;
  }

  searchInput?.addEventListener("input", applyFilters);

  categoryPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      activeCategory = pill.dataset.categoryFilter ?? "all";
      categoryPills.forEach((p) => p.classList.toggle("is-active", p === pill));
      applyFilters();
    });
  });
</script>

---
interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  lastPage: number;
}

const { prevUrl, nextUrl, currentPage, lastPage } = Astro.props;
---

{
  lastPage > 1 && (
    <nav class="blog-pagination" aria-label="Blog pagination">
      {prevUrl ? (
        <a href={prevUrl} class="blog-pagination__arrow" rel="prev">
          <span aria-hidden="true">←</span> Newer posts
        </a>
      ) : (
        <span class="blog-pagination__arrow is-disabled" aria-disabled="true">
          <span aria-hidden="true">←</span> Newer posts
        </span>
      )}

      <span class="blog-pagination__status">
        Page {currentPage} of {lastPage}
      </span>

      {nextUrl ? (
        <a href={nextUrl} class="blog-pagination__arrow" rel="next">
          Older posts <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="blog-pagination__arrow is-disabled" aria-disabled="true">
          Older posts <span aria-hidden="true">→</span>
        </span>
      )}
    </nav>
  )
}

<style>
  .blog-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .blog-pagination__arrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    color: var(--color-ink-800);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  a.blog-pagination__arrow:hover {
    border-color: var(--color-ink-600);
    background: var(--color-surface-alt);
  }

  .blog-pagination__arrow.is-disabled {
    color: var(--color-text-subtle);
    border-color: var(--color-border);
    opacity: 0.5;
    cursor: default;
  }

  .blog-pagination__status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  @media (max-width: 500px) {
    .blog-pagination {
      flex-wrap: wrap;
      justify-content: center;
    }

    .blog-pagination__status {
      order: -1;
      width: 100%;
      text-align: center;
      margin-bottom: var(--space-2);
    }
  }
</style>

---
// =============================================================================
// CONTACT FORM — wired to Web3Forms
// -----------------------------------------------------------------------------
// Submits via fetch() directly to Web3Forms' API (no page reload) and shows
// an inline success or error state. See https://web3forms.com for how the
// access key works — it's meant to be used client-side, not treated as a
// secret.
// =============================================================================

import TextField from "./TextField.astro";
import TextareaField from "./TextareaField.astro";
import SelectField from "./SelectField.astro";
import { SITE, WEB3FORMS_ACCESS_KEY } from "../../data/site";

const reasonOptions = [
  { label: "General question", value: "general" },
  { label: "Get a quote", value: "quote" },
  { label: "Existing policy", value: "existing-policy" },
  { label: "Other", value: "other" },
];
---

<form class="contact-form" id="contact-form">
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value={`New contact form message — ${SITE.name}`} />
  <input type="hidden" name="from_name" value={SITE.name} />
  {/* Honeypot spam trap — real visitors never fill this in; bots often do. */}
  <input type="checkbox" name="botcheck" class="contact-form__honeypot" tabindex="-1" autocomplete="off" />

  <div class="contact-form__grid">
    <TextField label="Full name" name="name" required autocomplete="name" />
    <TextField label="Email address" name="email" type="email" required autocomplete="email" />
  </div>
  <div class="contact-form__grid">
    <TextField label="Phone number" name="phone" type="tel" autocomplete="tel" hint="Optional" />
    <SelectField label="Reason for contacting" name="reason" options={reasonOptions} required />
  </div>
  <TextareaField label="Message" name="message" required placeholder="How can we help?" rows={6} />

  <button type="submit" class="contact-form__submit" data-submit-button>
    Send Message
  </button>

  <p class="contact-form__status" data-status role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .contact-form__submit {
    justify-self: start;
    padding: 1rem 2rem;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-cta);
    color: var(--color-cta-text);
    font-weight: 700;
    font-size: var(--text-base);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .contact-form__submit:hover {
    background: var(--color-cta-hover);
  }

  .contact-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .contact-form__status {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    min-height: 1.5em;
  }

  .contact-form__status[data-state="success"] {
    color: var(--color-moss-700);
    font-weight: 600;
  }

  .contact-form__status[data-state="error"] {
    color: var(--color-error-500);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }

    .contact-form__submit {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>("[data-status]");
  const submitButton = form?.querySelector<HTMLButtonElement>("[data-submit-button]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    // Honeypot check — if this hidden field got filled in, silently drop it.
    const honeypot = form.querySelector<HTMLInputElement>('[name="botcheck"]');
    if (honeypot?.checked) return;

    submitButton.disabled = true;
    submitButton.textContent = "Sending...";
    status.removeAttribute("data-state");
    status.textContent = "";

    try {
      const formData = new FormData(form);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        status.dataset.state = "success";
        status.textContent = "Thanks — your message has been sent. We'll get back to you soon.";
        form.reset();
        (window as any).trackConversionEvent?.("contact_form_submitted");
      } else {
        throw new Error(result.message || "Submission failed");
      }
    } catch {
      status.dataset.state = "error";
      status.textContent =
        "Something went wrong sending your message. Please try again, or reach us directly using the contact details on this page.";
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Send Message";
    }
  });
</script>

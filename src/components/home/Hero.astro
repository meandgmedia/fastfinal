---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import RouteLine from "../ui/RouteLine.astro";
import { SITE, CTA as CTA_COPY } from "../../data/site";
---

<section class="hero">
  <Container width="wide">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Final Expense Insurance</p>
        <h1>{SITE.tagline}</h1>
        <p class="lede">
          Get your quote, compare your options, and apply online. Some
          eligible applicants can complete the entire process — and get
          covered — in a single visit.
        </p>
        <div class="hero__actions">
          <Button href={CTA_COPY.quoteHref} variant="primary" size="lg" trackEvent="quote_cta_click">
            {CTA_COPY.primary}
          </Button>
          <Button href="/final-expense-insurance/" variant="secondary" size="lg">
            {CTA_COPY.learnMore}
          </Button>
        </div>
        <ul class="hero__trust">
          <li>No obligation to apply</li>
          <li>Compare options in one place</li>
          <li>Apply online, anytime</li>
        </ul>
      </div>

      <Card padding="lg" class="hero__quote-card" as="div">
        <div class="hero__quote-card-head">
          <p class="eyebrow">Get a Quote</p>
          <span class="hero__quote-badge">~2 minutes</span>
        </div>
        <h3>See your final expense options</h3>
        <p class="text-muted">
          Answer a few quick questions to see the coverage you may be
          eligible for.
        </p>

        <!--
          QUOTE RATER / APPLICATION WIDGET WILL BE INSTALLED HERE.
          See src/components/quote/QuoteRater.astro (Phase 3) for the
          dedicated, documented integration point for the Back Nine
          Insurance quote rater. This hero card intentionally mirrors
          that component's visual language so the homepage and the
          /get-a-quote/ page feel like one continuous product.
        -->
        <div class="hero__quote-preview" aria-hidden="true">
          <div class="hero__quote-row">
            <span>Coverage amount</span>
            <span class="text-mono">$10,000</span>
          </div>
          <div class="hero__quote-row">
            <span>Estimated monthly premium</span>
            <span class="text-mono">$—.—</span>
          </div>
          <div class="hero__quote-bar"><span></span></div>
        </div>

        <Button href={CTA_COPY.quoteHref} variant="primary" size="md" trackEvent="quote_cta_click" class="hero__quote-cta">
          {CTA_COPY.primaryShort}
        </Button>
      </Card>
    </div>

    <div class="hero__route">
      <RouteLine />
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-10);
    background: var(--color-bg);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-9);
    align-items: center;
  }

  .hero__copy h1 {
    margin-top: var(--space-3);
  }

  .hero__copy .lede {
    margin-top: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .hero__trust li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent-500);
  }

  .hero__quote-card {
    box-shadow: var(--shadow-lg);
  }

  .hero__quote-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hero__quote-badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-moss-700);
    background: var(--color-moss-100);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .hero__quote-card h3 {
    margin-top: var(--space-3);
  }

  .hero__quote-card p.text-muted {
    margin-top: var(--space-2);
  }

  .hero__quote-preview {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-3);
  }

  .hero__quote-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__quote-bar {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-line);
    overflow: hidden;
  }

  .hero__quote-bar span {
    display: block;
    width: 45%;
    height: 100%;
    background: var(--color-accent-500);
  }

  .hero__quote-cta {
    margin-top: var(--space-6);
    width: 100%;
  }

  .hero__route {
    margin-top: var(--space-11);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import RouteLine from "../ui/RouteLine.astro";
import QuoteRater from "../quote/QuoteRater.astro";
import { SITE, CTA as CTA_COPY, SERVICE_AREA } from "../../data/site";
---

<section class="hero">
  <Container width="wide">
    <div class="hero__copy">
      <p class="eyebrow">Final Expense Insurance in {SERVICE_AREA.stateName}</p>
      <h1>{SITE.tagline}</h1>
      <p class="lede">
        Get your quote, compare your options, and apply online. Some
        eligible applicants can complete the entire process — and get
        covered — in a single visit.
      </p>
      <div class="hero__actions">
        <Button href={CTA_COPY.quoteHref} variant="primary" size="lg" trackEvent="quote_cta_click">
          {CTA_COPY.primary}
        </Button>
        <Button href="/final-expense-insurance/" variant="secondary" size="lg">
          {CTA_COPY.learnMore}
        </Button>
      </div>
      <ul class="hero__trust">
        <li>Serving {SERVICE_AREA.stateName} residents</li>
        <li>No obligation to apply</li>
        <li>Apply online, anytime</li>
      </ul>
    </div>

    <div class="hero__quote-slot">
      <QuoteRater containerId="hero-quote-widget" />
    </div>

    <div class="hero__route">
      <RouteLine />
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-10);
    background: var(--color-bg);
  }

  .hero__copy {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero__copy h1 {
    margin-top: var(--space-3);
  }

  .hero__copy .lede {
    margin-top: var(--space-5);
    margin-inline: auto;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .hero__trust li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent-500);
  }

  .hero__quote-slot {
    max-width: 46rem;
    margin: var(--space-9) auto 0;
  }

  .hero__route {
    margin-top: var(--space-11);
  }
</style>

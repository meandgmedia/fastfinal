---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";

const uses = [
  "Funeral expenses",
  "Burial costs",
  "Cremation",
  "Cemetery expenses",
  "Outstanding bills",
  "Medical expenses",
  "Other final expenses",
];
---

<Section tone="paper">
  <div class="explainer">
    <div class="explainer__copy">
      <p class="eyebrow">Final Expense Insurance</p>
      <h2>What is Final Expense Insurance?</h2>
      <p class="lede">
        Final expense insurance is a smaller, permanent life insurance policy
        designed to help your family cover end-of-life costs without
        scrambling to pay out of pocket. It's built to be simple to
        understand and, for many applicants, simple to apply for.
      </p>
      <p class="text-muted">
        Coverage amounts are typically lower than traditional life insurance
        — often in the thousands rather than hundreds of thousands of
        dollars — which helps keep premiums manageable for people planning
        ahead.
      </p>
      <Button href="/final-expense-insurance/" variant="ghost">
        Learn more about final expense insurance →
      </Button>
    </div>

    <div class="explainer__uses">
      <p class="explainer__uses-label">Commonly used for</p>
      <ul class="explainer__uses-list">
        {uses.map((use) => <li>{use}</li>)}
      </ul>
    </div>
  </div>
</Section>

<style>
  .explainer {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-9);
    align-items: start;
  }

  .explainer__copy h2 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .explainer__copy .lede {
    margin-bottom: var(--space-4);
  }

  .explainer__copy .btn--ghost {
    margin-top: var(--space-3);
  }

  .explainer__uses {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .explainer__uses-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }

  .explainer__uses-list {
    display: grid;
    gap: var(--space-3);
  }

  .explainer__uses-list li {
    position: relative;
    padding-left: var(--space-5);
    font-weight: 500;
    color: var(--color-ink-800);
  }

  .explainer__uses-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent-500);
  }

  @media (max-width: 900px) {
    .explainer {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Container from "../ui/Container.astro";
import { SITE, SERVICE_AREA, LICENSED_AGENT, FOOTER_NAV, FOOTER_LEGAL, CTA as CTA_COPY } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container width="wide">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" class="footer__brand-link" aria-label={`${SITE.name} — Home`}>
          <img src="/brand/logo-lockup.png" alt="" class="footer__logo" width="1253" height="278" />
        </a>
        <p class="footer__desc">
          Compare final expense insurance options online and apply at your own pace — quote, compare, apply, get covered.
        </p>
        <a href={CTA_COPY.quoteHref} class="footer__cta-link" data-track-event="quote_cta_click">
          {CTA_COPY.primary} →
        </a>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        <h3 class="footer__heading">Site</h3>
        <ul>
          {FOOTER_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__contact">
        <h3 class="footer__heading">Contact</h3>
        <ul>
          <li><a href={`tel:${SITE.phone.tel}`} data-track-event="phone_click">{SITE.phone.display}</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href="/contact/">Contact form</a></li>
        </ul>
      </div>

      <nav class="footer__legal" aria-label="Legal">
        <h3 class="footer__heading">Legal</h3>
        <ul>
          {FOOTER_LEGAL.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <hr class="hr footer__divider" />

    <div class="footer__disclaimer">
      <p>
        {SITE.name} is a marketing website for final expense insurance products.
        Insurance products presented on this site are offered by licensed insurance agent
        <strong> {LICENSED_AGENT.name}</strong>, <strong>{LICENSED_AGENT.licenseLabel}</strong>,
        currently licensed to offer coverage in {SERVICE_AREA.stateName} only. Not all applicants
        will qualify for coverage. Quotes are estimates and are not a guarantee of coverage, rate,
        or approval. Coverage is issued by third-party insurance carriers, not by {SITE.shortName}.
        Final approval and any offer of coverage are subject to the underwriting guidelines of the
        issuing carrier.
      </p>
      <p class="text-subtle">
        © {year} {SITE.name}. All rights reserved. <span class="footer__domain">{SITE.domain}</span>
      </p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-bg);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-9) var(--space-7);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: var(--space-8);
  }

  .footer__brand-link {
    display: inline-block;
  }

  .footer__logo {
    display: block;
    height: 2.75rem;
    width: auto;
  }

  .footer__desc {
    margin-top: var(--space-5);
    max-width: 26rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .footer__cta-link {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--color-accent-700);
    font-weight: 600;
    text-decoration: none;
  }

  .footer__cta-link:hover {
    color: var(--color-accent-600);
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .footer__nav ul,
  .footer__contact ul,
  .footer__legal ul {
    display: grid;
    gap: var(--space-3);
  }

  .footer__nav a,
  .footer__contact a,
  .footer__legal a {
    display: inline-block;
    padding-block: var(--space-1);
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer__nav a:hover,
  .footer__contact a:hover,
  .footer__legal a:hover {
    color: var(--color-ink-900);
  }

  .footer__divider {
    border-top-color: var(--color-border);
    margin-block: var(--space-8);
  }

  .footer__disclaimer {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    max-width: 68rem;
    color: var(--color-text-muted);
  }

  .footer__disclaimer strong {
    color: var(--color-ink-900);
    font-weight: 600;
  }

  .footer__domain {
    font-family: var(--font-mono);
  }

  @media (max-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>

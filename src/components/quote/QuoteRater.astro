---
// =============================================================================
// QUOTE RATER — page-level chrome around the live Back Nine widget.
// -----------------------------------------------------------------------------
// The actual quote rater is the Back Nine embed rendered by
// BackNineWidget.astro (see that file for integration notes/limitations).
// This component just supplies the site's own framing around it — eyebrow,
// heading, trust row, and compliance disclaimer — so the widget sits inside
// the same card language used everywhere else on the site.
// =============================================================================

import BackNineWidget from "./BackNineWidget.astro";

interface Props {
  /** "full" (default) is the complete card used on /get-a-quote/. "compact" trims the trust row — used in tighter spaces like the homepage hero. */
  variant?: "full" | "compact";
  /** Must be unique if this component is ever rendered more than once on the same page. */
  containerId?: string;
}

const { variant = "full", containerId = "container-id" } = Astro.props;
---

<div class="quote-rater">
  <div class="quote-rater__head">
    <p class="eyebrow">Get a Quote</p>
    <h2 class="quote-rater__title">See your Final Expense Insurance options</h2>
  </div>

  <div class="quote-rater__surface">
    <BackNineWidget containerId={containerId} />
  </div>

  {
    variant === "full" && (
      <ul class="quote-rater__trust">
        <li>No obligation to apply</li>
        <li>Takes about 2 minutes</li>
        <li>Your information stays confidential</li>
      </ul>
    )
  }

  <p class="quote-rater__disclaimer text-subtle">
    Coverage available for eligible applicants. Quotes are estimates and not
    a guarantee of coverage, rate, or approval.
  </p>
</div>

<style>
  .quote-rater {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    box-shadow: var(--shadow-lg);
  }

  .quote-rater__title {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
  }

  .quote-rater__surface {
    margin-top: var(--space-6);
  }

  .quote-rater__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .quote-rater__trust li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .quote-rater__trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-moss-500);
  }

  .quote-rater__disclaimer {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 560px) {
    .quote-rater {
      padding: var(--space-5);
    }
  }
</style>

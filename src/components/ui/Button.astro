---
// Reusable Button. Renders an <a> when `href` is provided, otherwise a <button>.
// Kept intentionally simple/dependency-free so it stays fast and accessible.

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "dark" | "accent-outline" | "accent-solid";
  size?: "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  /** Analytics hook — e.g. "quote_cta_click". Wired up in Phase 8. */
  trackEvent?: string;
  ariaLabel?: string;
  /** Set to "_blank" for external links that should open in a new tab. rel="noopener noreferrer" is applied automatically. */
  target?: "_blank" | "_self";
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  trackEvent,
  ariaLabel,
  target,
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, `btn--${size}`, className]
  .filter(Boolean)
  .join(" ");
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  aria-label={ariaLabel}
  data-track-event={trackEvent}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn:active {
    transform: translateY(1px);
  }

  /* Sizes */
  .btn--md {
    padding: 0.85rem 1.5rem;
    font-size: var(--text-base);
  }

  .btn--lg {
    padding: 1.05rem 2rem;
    font-size: var(--text-md);
  }

  /* Variants */
  .btn--primary {
    background: var(--color-cta);
    color: var(--color-cta-text);
    border-color: var(--color-cta);
  }

  .btn--primary:hover {
    background: var(--color-cta-hover);
    border-color: var(--color-cta-hover);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-ink-800);
    border-color: var(--color-ink-800);
  }

  .btn--secondary:hover {
    background: var(--color-ink-800);
    color: var(--color-text-on-dark);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink-800);
    border-color: transparent;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
    border-radius: var(--radius-sm);
  }

  .btn--ghost:hover {
    color: var(--color-accent-700);
  }

  .btn--dark {
    background: var(--color-paper-050);
    color: var(--color-ink-900);
    border-color: var(--color-paper-050);
  }

  .btn--dark:hover {
    background: var(--color-accent-500);
    border-color: var(--color-accent-500);
    color: var(--color-accent-ink);
  }

  .btn--accent-outline {
    background: transparent;
    color: var(--color-accent-500);
    border-color: var(--color-accent-500);
  }

  .btn--accent-outline:hover {
    background: var(--color-accent-500);
    color: var(--color-accent-ink);
  }

  .btn--accent-solid {
    background: var(--color-accent-700);
    color: #ffffff;
    border-color: var(--color-accent-700);
  }

  .btn--accent-solid:hover {
    background: var(--color-accent-600);
    border-color: var(--color-accent-600);
  }
</style>

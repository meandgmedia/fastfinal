---
interface Props {
  /** "default" is the standard content width; "narrow" for text-heavy content like articles. */
  width?: "default" | "narrow" | "wide";
  class?: string;
}

const { width = "default", class: className = "" } = Astro.props;
---

<div class:list={["container", `container--${width}`, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .container--default {
    max-width: var(--container-max);
  }

  .container--narrow {
    max-width: var(--container-narrow);
  }

  .container--wide {
    max-width: 90rem;
  }
</style>

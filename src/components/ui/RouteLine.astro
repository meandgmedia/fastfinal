---
// The site's signature element: a connected route/path visualizing the
// four-step journey (Quote → Compare → Apply → Covered). Reused in the
// hero, the "How It Works" section, and the footer to reinforce that the
// process is short, linear, and fast.
import { JOURNEY_STEPS } from "../../data/site";

interface Props {
  /** 1-based index of the step to highlight as "current" (e.g. 1 = Quote). Omit for a neutral/marketing display. */
  activeStep?: number;
  /** "compact" removes descriptions — used in the footer / tight spaces. */
  compact?: boolean;
  tone?: "light" | "dark";
  class?: string;
}

const { activeStep, compact = false, tone = "light", class: className = "" } = Astro.props;
---

<ol
  class:list={[
    "route-line",
    `route-line--${tone}`,
    { "route-line--compact": compact },
    className,
  ]}
  aria-label="How the process works: Quote, Compare, Apply, Covered"
>
  {
    JOURNEY_STEPS.map((step, index) => {
      const stepNumber = index + 1;
      const state =
        activeStep === undefined
          ? "neutral"
          : stepNumber < activeStep
            ? "done"
            : stepNumber === activeStep
              ? "active"
              : "upcoming";
      return (
        <li class:list={["route-line__step", `route-line__step--${state}`]}>
          <span class="route-line__node" aria-hidden="true" />
          <span class="route-line__label">{step.label}</span>
          {!compact && <span class="route-line__desc">{step.description}</span>}
        </li>
      );
    })
  }
</ol>

<style>
  .route-line {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    counter-reset: step;
  }

  .route-line__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    flex: 1;
    padding-top: 1.65rem;
  }

  .route-line__step::before {
    /* connecting line segment */
    content: "";
    position: absolute;
    top: 0.5rem;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-line-strong);
  }

  .route-line__step:first-child::before {
    left: 50%;
    width: 50%;
  }

  .route-line__step:last-child::before {
    width: 50%;
  }

  .route-line__node {
    position: absolute;
    top: 0;
    left: calc(50% - 6px);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2.5px solid var(--color-ink-600);
  }

  .route-line__step--done .route-line__node,
  .route-line__step--active .route-line__node {
    border-color: var(--color-accent-500);
    background: var(--color-accent-500);
  }

  .route-line__label {
    width: 100%;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink-800);
  }

  .route-line__desc {
    width: 100%;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Dark tone (used on ink-background sections) */
  .route-line--dark .route-line__step::before {
    background: var(--color-ink-600);
  }

  .route-line--dark .route-line__node {
    background: var(--color-ink-900);
    border-color: var(--color-ink-400);
  }

  .route-line--dark .route-line__step--done .route-line__node,
  .route-line--dark .route-line__step--active .route-line__node {
    border-color: var(--color-accent-500);
    background: var(--color-accent-500);
  }

  .route-line--dark .route-line__label {
    color: var(--color-text-on-dark);
  }

  .route-line--dark .route-line__desc {
    color: var(--color-text-on-dark-muted);
  }

  .route-line--compact .route-line__step {
    padding-top: 1.25rem;
  }

  /* Mobile: switch to a vertical timeline for readability */
  @media (max-width: 640px) {
    .route-line {
      flex-direction: column;
      gap: 0;
    }

    .route-line__step {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
      padding-top: 0;
      padding-bottom: var(--space-6);
      padding-left: 1.65rem;
    }

    .route-line__step:last-child {
      padding-bottom: 0;
    }

    .route-line__step::before {
      top: 0;
      left: 6px;
      width: 2px;
      height: 100%;
    }

    .route-line__step:first-child::before {
      top: 0.5rem;
      left: 6px;
      width: 2px;
      height: calc(100% - 0.5rem);
    }

    .route-line__step:last-child::before {
      height: 0.5rem;
      width: 2px;
    }

    .route-line__node {
      top: 0.15rem;
      left: 0;
    }

    .route-line__label,
    .route-line__desc {
      text-align: left;
      width: auto;
    }
  }
</style>

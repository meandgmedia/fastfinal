---
// Self-hosted variable fonts (better Core Web Vitals than a third-party
// font CDN request — no external network round-trip, no layout shift
// waiting on Google Fonts).
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";

import "../styles/global.css";

import SEO from "../components/seo/SEO.astro";
import AnalyticsHead from "../components/analytics/AnalyticsHead.astro";
import TrackingScript from "../components/analytics/TrackingScript.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import StickyMobileCTA from "../components/layout/StickyMobileCTA.astro";
import { organizationSchema, websiteSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: "website" | "article";
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  appendBrand?: boolean;
  /** Hide the sticky mobile CTA — used on the quote page itself, thank-you pages, etc. */
  hideStickyCta?: boolean;
}

const {
  title,
  description,
  path,
  type,
  noindex,
  schema,
  ogImage,
  appendBrand,
  hideStickyCta = false,
} = Astro.props;

const pageSchema = [organizationSchema(), websiteSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16302b" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <SEO title={title} description={description} path={path} type={type} noindex={noindex} schema={pageSchema} ogImage={ogImage} appendBrand={appendBrand} />
    <AnalyticsHead />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideStickyCta && <StickyMobileCTA />}
    <TrackingScript />
  </body>
</html>

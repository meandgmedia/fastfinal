---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/marketing/PageHero.astro";
import Section from "../../components/ui/Section.astro";
import Card from "../../components/ui/Card.astro";
import BlogPagination from "../../components/blog/BlogPagination.astro";
import { CTA as CTA_COPY } from "../../data/site";
import { BLOG_CATEGORIES } from "../../content.config";
import { webPageSchema, breadcrumbSchema } from "../../lib/schema";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const title = page.currentPage === 1 ? "Blog" : `Blog — Page ${page.currentPage}`;
const description =
  "Guides and articles on Florida final expense insurance, burial insurance, and life insurance for seniors — written to help you make an informed decision.";
const path = page.currentPage === 1 ? "/blog/" : `/blog/${page.currentPage}/`;

// Category pills reflect categories present across the whole blog, not just
// this page, but filtering only ever operates on the posts actually
// rendered on the current page — see the note in the script below.
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const usedCategorySlugs = new Set(allPosts.map((p) => p.data.category));
const activeCategories = BLOG_CATEGORIES.filter((c) => usedCategorySlugs.has(c.slug));

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

const schema = [
  webPageSchema({ title, description, path }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema} noindex={page.currentPage > 1}>
  <PageHero
    eyebrow="Blog"
    heading="Florida final expense insurance guides & articles"
    lede="Straightforward, no-fluff explainers to help you understand final expense insurance before you buy — not just before you buy from us."
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path: "/blog/" }]}
    primaryLabel={CTA_COPY.secondary}
    primaryHref={CTA_COPY.quoteHref}
  />

  <Section tone="surface">
    <div class="blog-controls">
      <label class="blog-search" for="blog-search-input">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="blog-search__icon"><circle cx="9" cy="9" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="14" y1="14" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input
          type="search"
          id="blog-search-input"
          data-blog-search
          placeholder="Search this page..."
          aria-label="Search articles on this page"
        />
      </label>

      {
        activeCategories.length > 0 && (
          <div class="blog-categories" role="group" aria-label="Filter by category">
            <button type="button" class="blog-category-pill is-active" data-category-filter="all">
              All
            </button>
            {activeCategories.map((cat) => (
              <button type="button" class="blog-category-pill" data-category-filter={cat.slug}>
                {cat.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <p class="blog-empty-state" data-empty-state hidden>No articles on this page match your search — try Newer/Older posts below, or clear your search.</p>

    {
      page.data.length > 0 ? (
        <ul class="post-list" data-post-list>
          {page.data.map((post) => (
            <Card
              as="li"
              href={`/blog/${post.id}/`}
              padding="lg"
              class="post-list__card"
              data-post-card
              data-category={post.data.category}
              data-search-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
            >
              <div class="post-list__art">
                <img src={post.data.heroImage.url} alt="" width="800" height="450" loading="lazy" />
              </div>
              <time datetime={post.data.publishDate.toISOString()} class="post-list__date text-mono text-subtle">
                {dateFormatter.format(post.data.publishDate)}
              </time>
              <h2 class="post-list__title">{post.data.title}</h2>
              <p class="text-muted">{post.data.description}</p>
              <span class="post-list__link">Read article →</span>
            </Card>
          ))}
        </ul>
      ) : (
        <p class="text-muted">New articles are on the way — check back soon.</p>
      )
    }

    <BlogPagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </Section>
</BaseLayout>

<style>
  .blog-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .blog-search {
    position: relative;
    display: block;
    max-width: 26rem;
  }

  .blog-search__icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-text-subtle);
    pointer-events: none;
  }

  .blog-search input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-base);
  }

  .blog-search input:focus-visible {
    border-color: var(--color-ink-800);
  }

  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-category-pill {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .blog-category-pill:hover {
    border-color: var(--color-ink-600);
  }

  .blog-category-pill.is-active {
    background: var(--color-ink-900);
    border-color: var(--color-ink-900);
    color: var(--color-text-on-dark);
  }

  .blog-empty-state {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: var(--container-max);
  }

  .post-list__art {
    margin: calc(var(--space-7) * -1) calc(var(--space-7) * -1) var(--space-5);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
  }

  .post-list__art img {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .post-list__date {
    display: block;
    margin-bottom: var(--space-3);
  }

  .post-list__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .post-list__link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-accent-700);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .post-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Search/category filtering operates only on posts rendered on the
  // current page — pagination is what keeps the blog from loading every
  // post at once, so this intentionally doesn't reach across pages.
  const searchInput = document.querySelector<HTMLInputElement>("[data-blog-search]");
  const categoryPills = document.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-post-card]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  let activeCategory = "all";

  function applyFilters() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
      const matchesSearch = !query || (card.dataset.searchText ?? "").includes(query);
      const visible = matchesCategory && matchesSearch;
      card.hidden = !visible;
      if (visible) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  searchInput?.addEventListener("input", applyFilters);

  categoryPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      activeCategory = pill.dataset.categoryFilter ?? "all";
      categoryPills.forEach((p) => p.classList.toggle("is-active", p === pill));
      applyFilters();
    });
  });
</script>

---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BlogListing from "../../components/blog/BlogListing.astro";

export const getStaticPaths = (async () => {
  const PAGE_SIZE = 10;
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  );
  const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  // Page 1 is handled by src/pages/blog/index.astro — start at page 2 so
  // this route never generates a path that collides with the bare /blog/
  // route (the root cause of the earlier "conflicts with higher priority
  // route `/blog`" build warning).
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const currentPage = i + 2;
    return {
      params: { page: String(currentPage) },
      props: { currentPage, lastPage, allPosts: posts },
    };
  });
}) satisfies GetStaticPaths;

const { currentPage, lastPage, allPosts } = Astro.props;
const pagePosts = allPosts.slice((currentPage - 1) * 10, currentPage * 10);
const prevUrl = currentPage === 2 ? "/blog/" : `/blog/${currentPage - 1}/`;
const nextUrl = currentPage < lastPage ? `/blog/${currentPage + 1}/` : undefined;
---

<BlogListing
  posts={pagePosts}
  currentPage={currentPage}
  lastPage={lastPage}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
/>

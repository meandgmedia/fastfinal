---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/marketing/PageHero.astro";
import Section from "../../components/ui/Section.astro";
import Card from "../../components/ui/Card.astro";
import { CTA as CTA_COPY } from "../../data/site";
import { webPageSchema, breadcrumbSchema } from "../../lib/schema";

const title = "Blog";
const description =
  "Guides and articles on final expense insurance, burial insurance, and life insurance for seniors — written to help you make an informed decision.";
const path = "/blog/";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

const schema = [
  webPageSchema({ title, description, path }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <PageHero
    eyebrow="Blog"
    heading="Final expense insurance guides & articles"
    lede="Straightforward, no-fluff explainers to help you understand final expense insurance before you buy — not just before you buy from us."
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Blog", path }]}
    primaryLabel={CTA_COPY.secondary}
    primaryHref={CTA_COPY.quoteHref}
  />

  <Section tone="surface">
    {
      posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => (
            <Card as="li" href={`/blog/${post.id}/`} padding="lg" class="post-list__card">
              <time datetime={post.data.publishDate.toISOString()} class="post-list__date text-mono text-subtle">
                {dateFormatter.format(post.data.publishDate)}
              </time>
              <h2 class="post-list__title">{post.data.title}</h2>
              <p class="text-muted">{post.data.description}</p>
              <span class="post-list__link">Read article →</span>
            </Card>
          ))}
        </ul>
      ) : (
        <p class="text-muted">New articles are on the way — check back soon.</p>
      )
    }
  </Section>
</BaseLayout>

<style>
  .post-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: var(--container-max);
  }

  .post-list__date {
    display: block;
    margin-bottom: var(--space-3);
  }

  .post-list__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .post-list__link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-accent-700);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .post-list {
      grid-template-columns: 1fr;
    }
  }
</style>

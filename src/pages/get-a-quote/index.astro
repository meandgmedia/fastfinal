---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import RouteLine from "../../components/ui/RouteLine.astro";
import QuoteRater from "../../components/quote/QuoteRater.astro";
import FAQAccordion from "../../components/faq/FAQAccordion.astro";
import { SERVICE_AREA } from "../../data/site";
import { webPageSchema, breadcrumbSchema, faqSchema } from "../../lib/schema";
import { HOMEPAGE_FAQS } from "../../data/faq";

const title = "Get Your Florida Final Expense Insurance Quote";
const description =
  "Get your free Florida final expense insurance quote online. Compare your available options and apply — coverage available for eligible Florida residents.";
const path = "/get-a-quote/";

// Reuse the questions from the homepage FAQ that are most relevant to
// someone who's actually on the quote page right now.
const quotePageFaqs = HOMEPAGE_FAQS.filter((item) =>
  [
    "Is Florida Final Expense Insurance available outside Florida?",
    "How much does final expense insurance cost?",
    "Do I need a medical exam?",
    "How quickly can I get coverage?",
  ].includes(item.question)
);

const schema = [
  webPageSchema({ title, description, path }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Get a Quote", path },
  ]),
  faqSchema(quotePageFaqs),
];
---

<BaseLayout title={title} description={description} path={path} schema={schema} hideStickyCta appendBrand={false}>
  <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Get a Quote", path }]} />

  <Section tone="paper" centered>
    <div class="quote-page__intro">
      <p class="eyebrow">Final Expense Insurance in {SERVICE_AREA.stateName}</p>
      <h1>Get Your Florida Final Expense Insurance Quote</h1>
      <p class="lede">
        Compare your options and find coverage that fits your needs.
        Answer a few quick questions to see what may be available to you —
        there's no obligation to apply.
      </p>
      <p class="quote-page__area-note">
        {SERVICE_AREA.shortDisclosure}
      </p>

      <div class="quote-page__route">
        <RouteLine activeStep={1} compact />
      </div>
    </div>

    <div class="quote-page__widget">
      <QuoteRater />
    </div>
  </Section>

  <Section tone="surface" eyebrow="Questions" heading="Before you get started" width="narrow" centered>
    <FAQAccordion items={quotePageFaqs} />
  </Section>
</BaseLayout>

<style>
  .quote-page__intro {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .quote-page__intro h1 {
    margin-top: var(--space-3);
  }

  .quote-page__intro .lede {
    margin-top: var(--space-5);
    margin-inline: auto;
  }

  .quote-page__area-note {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-moss-700);
  }

  .quote-page__route {
    margin-top: var(--space-8);
  }

  .quote-page__widget {
    max-width: 46rem;
    margin: var(--space-9) auto 0;
  }
</style>
